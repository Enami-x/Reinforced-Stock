# ─── Database ────────────────────────────────────────────
POSTGRES_USER=stock_agent
POSTGRES_PASSWORD=stock_secret
POSTGRES_DB=stock_insights
DATABASE_URL=postgresql://stock_agent:stock_secret@localhost:5432/stock_insights

# ─── NVIDIA NIM ───────────────────────────────────────────
NIM_API_KEY=nvapi-your-key-here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NIM_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# ─── Finnhub ──────────────────────────────────────────────
FINNHUB_API_KEY=your-finnhub-key-here

# ─── Watchlist ────────────────────────────────────────────
WATCHLIST=AAPL,MSFT,TSLA,NVDA,GOOGL

# ─── Scheduler ────────────────────────────────────────────
# Full watchlist scan interval in minutes (default: every 4 hours)
SCAN_INTERVAL_MINUTES=240
# News polling interval in minutes
NEWS_POLL_INTERVAL_MINUTES=15
# Resolution job runs daily at this time (24h UTC)
RESOLUTION_HOUR_UTC=22

# ─── Agent settings ───────────────────────────────────────
# Number of trading days after prediction before resolution
RESOLUTION_HORIZON_DAYS=5
# % threshold for correct prediction (2 = 2%)
CORRECTNESS_THRESHOLD_PCT=2.0
# Top-K similar past predictions to retrieve from pgvector
MEMORY_TOP_K=5
# Hours of news lookback per poll cycle
NEWS_LOOKBACK_HOURS=24
